# Local-only Django configuration. Do not commit a real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
# Comma-separated host names for non-development environments.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional absolute or relative SQLite database path.
# DJANGO_DATABASE_NAME=db.sqlite3
